#!/usr/bin/env php
<?php

declare(strict_types=1);

require dirname(__DIR__) . '/vendor/autoload.php';

use Normalizzatore\Application\AddressProcessorFactory;
use Normalizzatore\Csv\AddressProcessingResultSerializer;
use Normalizzatore\Csv\CsvHeaderMap;
use Normalizzatore\Csv\CsvNormalizationPipeline;
use Normalizzatore\Csv\CsvReader;
use Normalizzatore\Csv\CsvWriter;
use Normalizzatore\Csv\NormalizeArguments;

if (($argv[1] ?? null) !== 'normalize') {
    fwrite(STDERR, "Usage: bin/normalizzatore normalize input.csv output.csv [--delimiter=\";\"] [--fuzzy]\nFuzzy: abbreviazioni e typo supportati, solo dopo un lookup deterministico della via senza risultati.\nSummary: ricerche = chiamate provider; match/ambigui = esiti nominali; risolti = match nominali confermati dal resolver CAP.\n");
    exit(2);
}

try {
    $options = NormalizeArguments::parse(array_slice($argv, 2));
    $root = dirname(__DIR__);
    if (!is_file($options->inputPath) || !is_readable($options->inputPath)) {
        throw new RuntimeException(sprintf('Input CSV is not a readable file: %s', $options->inputPath));
    }
    if (file_exists($options->outputPath) || is_link($options->outputPath)) {
        throw new RuntimeException(sprintf('Output file already exists: %s', $options->outputPath));
    }
    $inputCsv = (new CsvReader())->open($options->inputPath, $options->delimiter);
    CsvHeaderMap::fromHeader($inputCsv->header, AddressProcessingResultSerializer::OUTPUT_COLUMNS);
    $processor = AddressProcessorFactory::create($root);
    $pipeline = new CsvNormalizationPipeline(new CsvReader(), new CsvWriter(), $processor, new AddressProcessingResultSerializer());
    $summary = $pipeline->run($options->inputPath, $options->outputPath, $options->delimiter, $options->fuzzy);
    fwrite(STDOUT, $summary->toText());
} catch (Throwable $exception) {
    fwrite(STDERR, 'Errore: ' . $exception->getMessage() . "\n");
    exit(1);
}
