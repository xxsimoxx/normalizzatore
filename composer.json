{
    "name": "capizza/normalizzatore",
    "description": "CLI tool for normalizing Italian postal addresses in CSV files.",
    "type": "project",
    "require": {
        "php": ">=8.2",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Normalizzatore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Normalizzatore\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
